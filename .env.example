DATABASE_URL=./data/app.db

# Python AI Worker (use Docker service name when running in containers)
PYTHON_WORKER_URL=http://ai-worker:8001

# Ollama LLM runtime (use Docker service name when running in containers)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b

# Retrieval settings
SIMILARITY_THRESHOLD=0.20
TOP_K=3
